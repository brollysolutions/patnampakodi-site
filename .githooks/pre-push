#!/usr/bin/env bash
set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD || true)"
case "$branch" in
  main|master|prod)
    echo "ERROR: direct pushes from protected branch '$branch' are blocked. Use a task branch and PR." >&2
    exit 1
    ;;
esac

# The shared gate runs locally and in CI.
# Fixture Git commands must discover their own repository, not inherit this hook's.
(
  git_local_environment="$(git rev-parse --local-env-vars)"
  while IFS= read -r git_local_name; do
    unset "$git_local_name"
  done <<< "$git_local_environment"
  uv --cache-dir .uv-cache run --no-project --python '>=3.11' python scripts/verify_workflow.py fast
) </dev/null

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/prod)
      echo "ERROR: direct pushes to protected ref '$remote_ref' are blocked. Use a PR." >&2
      exit 1
      ;;
  esac
done

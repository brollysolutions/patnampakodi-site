{
  "name": "pakodi-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3501",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3501",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts *.mjs *.ts",
    "format": "prettier --write src tests scripts *.mjs *.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "contracts": "openapi-typescript ../../packages/contracts/openapi.json -o ../../packages/contracts/schema.d.ts",
    "audit:performance": "node scripts/lighthouse.mjs",
    "images": "node scripts/images.mjs",
    "prebuild": "npm run images",
    "predev": "npm run images"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/poppins": "5.2.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "lighthouse": "13.4.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

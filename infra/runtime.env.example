# Non-secret deployment options. The operator chooses the real host and directory.
PAKODI_HOST=patnampakodi.com
PAKODI_SECRETS_DIR=/srv/pakodi-secrets
# First three IPv4 octets of a free private /24; subnet and proxy trust move together.
PAKODI_NETWORK_PREFIX=172.29.91
# Use nginx behind the existing host Nginx; direct lets Caddy own ports 80/443.
PAKODI_PROXY_MODE=direct
PAKODI_PROXY_PORT=3502
DEPLOYMENT_ENV=preview
SITE_INDEXABLE=false
META_PHONE_ID=
META_GRAPH_VERSION=
GA4_MEASUREMENT_ID=
